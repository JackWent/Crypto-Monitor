# App
NODE_ENV=production
PORT=7050
DATA_DIR=/data
TZ=Europe/London
MINER_STATS_CACHE_TTL_MS=10000
HASHRATE_SAMPLE_MIN_INTERVAL_MS=30000
DATA_RETENTION_DAYS=365

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=crypto_dashboard
POSTGRES_USER=crypto_dashboard
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_SSL=false

# Mining
XMR_WALLET_ADDRESS=your_xmr_wallet_address

# Microsoft Graph email
GRAPH_TENANT_ID=your_tenant_id
GRAPH_CLIENT_ID=your_client_id
GRAPH_CLIENT_SECRET=your_client_secret
GRAPH_SENDER_EMAIL=notifications@example.com
GRAPH_RECIPIENT_EMAILS=you@example.com

# Optional: who gets miner offline/back-online alerts. Defaults to GRAPH_RECIPIENT_EMAILS if unset.
ALERT_RECIPIENT_EMAILS=you@example.com
# Optional: how long a worker must be offline before an alert fires (minutes).
OFFLINE_ALERT_THRESHOLD_MINUTES=10

# Optional: used in email links/logo
DASHBOARD_PUBLIC_URL=http://localhost:7050
# Use a public HTTPS URL for best email client compatibility.
DASHBOARD_LOGO_URL=https://your-public-domain.example/xmr-logo.png

# Optional admin auth gate for Admin Functions in the dashboard UI.
# Set ADMIN_PASSWORD to require unlock before admin features are visible/usable.
ADMIN_PASSWORD=
# Recommended when ADMIN_PASSWORD is set. Use a long random string.
ADMIN_SESSION_SECRET=
# Optional: session lifetime in milliseconds (minimum enforced: 900000 / 15 minutes).
ADMIN_SESSION_TTL_MS=43200000
# Set true when serving over HTTPS and you want Secure cookies only.
ADMIN_COOKIE_SECURE=false
